# ============================================
# Postify Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# --------------------------------------------
# Database (MySQL)
# --------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/postify?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------
# Server
# --------------------------------------------
PORT=8080

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
# Must be at least 256 bits (32 bytes) for HS256
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --------------------------------------------
# ML Service (Python)
# --------------------------------------------
ML_BASE_URL=http://localhost:8000
ML_SERVICE_TOKEN=

# --------------------------------------------
# Kafka
# --------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --------------------------------------------
# Cloudinary (Image Storage)
# --------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --------------------------------------------
# CORS
# --------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --------------------------------------------
# Local File Storage (fallback)
# --------------------------------------------
STORAGE_BASE_PATH=./uploads
STORAGE_AVATAR_PATH=avatars
STORAGE_POST_PATH=posts

# --------------------------------------------
# Production HikariCP (optional)
# --------------------------------------------
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
